# Copy to mobile/.env and fill in. Never commit the real .env.
#
# From your Supabase project settings → API.
# The project MUST be in ap-south-1 (Mumbai) — see CONTEXT.md §5. The region cannot
# be changed after the project is created.
#
# EXPO_PUBLIC_ vars are embedded in the app binary and are NOT secret. That is fine
# for the anon key, which is designed to be public: access is enforced by RLS and
# column grants in the database, not by hiding this value.
#
# The service_role key must never appear in this file or anywhere in mobile/.
# It bypasses RLS entirely and belongs only in Edge Functions.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Web OAuth client from Google Cloud (type: Web application).
# Also enable Authentication → Providers → Google in the Supabase dashboard
# with the same client ID. Until both exist, the Google button stays hidden
# and email/password is the sign-in path.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
